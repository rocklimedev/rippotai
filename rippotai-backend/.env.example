# Zoho Cliq: merge these server-only settings into your existing backend .env.
# Keep your existing database, FTP, and other backend settings.
ZOHO_CLIQ_ENABLED=false
# Recommended: paste the COMPLETE generated channel webhook URL (including zapikey).
# When set, OAuth credentials below are not used. Keep this URL secret.
ZOHO_CLIQ_WEBHOOK_URL=
# Optional OAuth fallback when no webhook URL is configured:
ZOHO_CLIQ_MESSAGE_URL=https://cliq.zoho.in/company/60062812007/api/v2/channelsbyname/rippotaiwebdesk/message
ZOHO_CLIQ_CLIENT_ID=
ZOHO_CLIQ_CLIENT_SECRET=
ZOHO_CLIQ_REFRESH_TOKEN=
# Optional: bot must be a participant in the channel.
ZOHO_CLIQ_BOT_UNIQUE_NAME=
# Optional short-lived alternative for testing; overrides refresh credentials.
ZOHO_CLIQ_ACCESS_TOKEN=
